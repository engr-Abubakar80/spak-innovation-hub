# ---------------------------------------------------------------------------
# SPAK Innovation Hub — Environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/spak_hub?schema=public"

# NextAuth / Auth.js
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Public base URL of the deployed application (used in emails / metadata).
APP_BASE_URL="http://localhost:3000"

# IANA timezone used to display booking times (organization local time).
ORG_TIMEZONE="Africa/Lagos"

# --- Email delivery --------------------------------------------------------
# When EMAIL_ENABLED=false, emails are written to the server log (dev transport)
# and the UI never claims delivery succeeded. Set to true and provide SMTP to
# enable real delivery.
EMAIL_ENABLED="false"
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="SPAK Innovation Hub <spakhub@gmail.com>"

# --- Media storage ---------------------------------------------------------
# "local" stores uploads under ./public/uploads (dev only).
# "s3" requires the S3_* variables below.
MEDIA_STORAGE="local"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""

# --- First administrator seed ---------------------------------------------
# Used only by `npm run db:seed` / `npm run admin:create`.
SEED_ADMIN_EMAIL="admin@spakhub.ng"
SEED_ADMIN_PASSWORD="ChangeMe!2024"
SEED_ADMIN_NAME="SPAK Administrator"
